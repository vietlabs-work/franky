# Franky configuration. Copy to .env and fill in. NEVER commit the real .env.
# Every value below is a PLACEHOLDER - replace with your own.

# --- Engine selection -------------------------------------------------------
# Which coding agent runs inside the container. Default: pi.
#   pi     - vendor-neutral, bring-your-own-key (BYOK), many providers
#   claude - Claude Code (claude -p), uses your Claude subscription token
FRANKY_ENGINE=pi

# --- Trusted-repo allowlist (REQUIRED, fail-closed) -------------------------
# Comma-separated owner/repo entries Franky is permitted to act on. If this is
# unset or empty, Franky refuses every task. Egress is allowlisted (v0.2), but
# only list repos whose issues and code you trust.
FRANKY_ALLOWED_REPOS=your-org/your-repo,your-org/another-repo

# --- Egress allowlist extras (OPTIONAL, NOT fail-closed) --------------------
# The default allowlist already covers your provider + GitHub + npm/PyPI. Add
# comma-separated extra domains here only if a task needs another host (e.g. a
# private package mirror). Squid `.example.com` matches subdomains only, so add
# the apex `example.com` too if you need it.
# FRANKY_EXTRA_ALLOWED_DOMAINS=mirror.internal,.example.com

# --- GitHub (clone + open PR inside the container) --------------------------
# Scope this token narrowly: contents + pull_requests on the target repos only.
GH_TOKEN=ghp_your_token_here

# --- pi engine creds (BYOK - set ONE provider the engine should use) --------
# pi reads whichever provider var is present. Examples (pick one):
OPENROUTER_API_KEY=sk-or-your_key_here
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OLLAMA_HOST=http://your-ollama-host:11434

# --- claude engine creds (only needed when FRANKY_ENGINE=claude) ------------
# Long-lived subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=your_oauth_token_here

# --- Auto-update hint on `franky build` (OPTIONAL, host CLI only) -----------
# By default `franky build` does a tight (~1s, cached) check and prints a
# one-line stderr hint when a newer release exists - it never blocks the build.
# These flags steer ONLY the host CLI and are never forwarded into the task
# container.
#   FRANKY_NO_UPDATE_CHECK=1  silence the check entirely.
#   FRANKY_AUTO_UPDATE=1      opt in to auto-installing the new release for your
#                             NEXT build (still no mid-build re-exec).
# FRANKY_NO_UPDATE_CHECK=1
# FRANKY_AUTO_UPDATE=1

# --- JIRA input (OPTIONAL, host-side only) ----------------------------------
# Needed only for `franky build jira <KEY> --repo owner/repo`. Franky fetches the
# issue on the HOST and feeds its text to the agent; these never enter the
# container. JIRA_BASE_URL must be https://.
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@your-org.com
# JIRA_API_TOKEN=your_jira_api_token_here

# --- Image overrides (dev only) -----------------------------------------------
# By default the CLI pulls ghcr.io/vietlabs-work/franky:<version> and
# ghcr.io/vietlabs-work/franky-proxy:<version> from GHCR. Set these to a local tag
# to bypass GHCR entirely during development.
# FRANKY_IMAGE=franky
# FRANKY_PROXY_IMAGE=franky-proxy
