abi <abi/3.0>,

#include <tunables/global>

profile franky-task flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=franky-task,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^kn]** w,
  deny @{PROC}/sys/{n[^e]**,ne[^t]**,net[^/]**,net/[^i]**,net/i[^p]**,net/ip[^v]**,net/ipv[^46]**,net/ipv4[^/]**,net/ipv4/[^i]**,net/ipv4/i[^p]**,net/ipv4/ip[^_]**,net/ipv4/ip_[^u]**,net/ipv4/ip_u[^n]**,net/ipv4/ip_un[^p]**,net/ipv4/ip_unp[^r]**,net/ipv4/ip_unpr[^i]**,net/ipv4/ip_unpri[^v]**,net/ipv4/ip_unpriv[^i]**,net/ipv4/ip_unprivi[^l]**,net/ipv4/ip_unprivil[^e]**,net/ipv4/ip_unprivile[^g]**,net/ipv4/ip_unprivileg[^e]**,net/ipv4/ip_unprivilege[^d]**,net/ipv4/ip_unprivileged[^_]**,net/ipv4/ip_unprivileged_[^p]**,net/ipv4/ip_unprivileged_p[^o]**,net/ipv4/ip_unprivileged_po[^r]**,net/ipv4/ip_unprivileged_por[^t]**,net/ipv4/ip_unprivileged_port[^_]**,net/ipv4/ip_unprivileged_port_[^s]**,net/ipv4/ip_unprivileged_port_s[^t]**,net/ipv4/ip_unprivileged_port_st[^a]**,net/ipv4/ip_unprivileged_port_sta[^r]**,net/ipv4/ip_unprivileged_port_star[^t]**,net/ipv4/ip_unprivileged_port_start?**} w,
  deny @{PROC}/sys/net/ipv6/{[^c]**,c[^o]**,co[^n]**,con[^f]**,conf[^/]**} w,
  deny @{PROC}/sys/net/ipv6/conf/*/{[^d]**,d[^i]**,di[^s]**,dis[^a]**,disa[^b]**,disab[^l]**,disabl[^e]**,disable[^_]**,disable_[^i]**,disable_i[^p]**,disable_ip[^v]**,disable_ipv[^6]**,disable_ipv6?**} w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  mount,
  pivot_root,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=franky-task,
}
